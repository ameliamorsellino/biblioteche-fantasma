@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix adms: <http://www.w3.org/ns/adms#> .

<https://biblioteche-fantasma.invalid/dataset/biblioteche-fantasma>
    a dcat:Dataset ;
    dct:title "Biblioteche Fantasma - analisi delle biblioteche italiane non pienamente operative"@it ;
    dct:description "Dataset derivato da snapshot ICCU 2026-09-08 e dati demografici ISTAT POSAS 2019/2025; include dati tabellari, modello RDF e risultati di analisi. Le URI locali sono di sviluppo e non dereferenziabili."@it ;
    dct:issued "2026-09-08"^^xsd:date ;
    dct:modified "2026-09-08"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/ITA> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/ITA> ;
    dct:publisher <https://biblioteche-fantasma.invalid/agent/project> ;
    dct:creator <https://biblioteche-fantasma.invalid/agent/project> ;
    dct:rightsHolder <https://biblioteche-fantasma.invalid/agent/project> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
    dcat:keyword "biblioteche"@it, "ICCU"@it, "open data"@it, "linked open data"@it, "demografia"@it ;
    dcat:distribution <https://biblioteche-fantasma.invalid/distribution/analysis-municipality-csv>,
                      <https://biblioteche-fantasma.invalid/distribution/library-csv>,
                      <https://biblioteche-fantasma.invalid/distribution/rdf-turtle> .

<https://biblioteche-fantasma.invalid/agent/project> a foaf:Agent ; foaf:name "Progetto universitario Biblioteche Fantasma"@it .

<https://biblioteche-fantasma.invalid/distribution/analysis-municipality-csv>
    a dcat:Distribution ; dct:title "Dataset analitico comunale CSV"@it ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
    dcat:mediaType "text/csv" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:downloadURL <file:data/processed/csv/analysis_municipality.csv> .

<https://biblioteche-fantasma.invalid/distribution/library-csv>
    a dcat:Distribution ; dct:title "Master biblioteche CSV"@it ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
    dcat:mediaType "text/csv" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:downloadURL <file:data/processed/csv/library.csv> .

<https://biblioteche-fantasma.invalid/distribution/rdf-turtle>
    a dcat:Distribution ; dct:title "Knowledge graph RDF/Turtle"@it ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> ;
    dcat:mediaType "text/turtle" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:downloadURL <file:rdf/data.ttl> .
