@prefix bf: <urn:biblioteche-fantasma:provenance:> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bf:src-iccu a prov:Entity ; dct:title "ICCU Anagrafe snapshot 2026-09-08"@it .
bf:src-istat-2019 a prov:Entity ; dct:title "ISTAT POSAS 2019"@it .
bf:src-istat-2025 a prov:Entity ; dct:title "ISTAT POSAS 2025"@it .
bf:cleaning a prov:Activity ; prov:used bf:src-iccu ; dct:description "Pulizia deterministica ICCU senza sovrascrittura dei RAW"@it .
bf:harmonization a prov:Activity ; prov:used bf:src-istat-2019, bf:src-istat-2025 ; dct:description "Armonizzazione comunale 2019→2025"@it .
bf:integration a prov:Activity ; prov:used bf:cleaned-iccu, bf:harmonized-population ; dct:description "Integrazione ICCU→ISTAT via codice comune"@it .
bf:cleaned-iccu a prov:Entity ; prov:wasGeneratedBy bf:cleaning ; prov:wasDerivedFrom bf:src-iccu .
bf:harmonized-population a prov:Entity ; prov:wasGeneratedBy bf:harmonization ; prov:wasDerivedFrom bf:src-istat-2019, bf:src-istat-2025 .
bf:derived-dataset a prov:Entity ; prov:wasGeneratedBy bf:integration ; prov:wasDerivedFrom bf:src-iccu, bf:src-istat-2019, bf:src-istat-2025 ; dct:issued "2026-09-11"^^xsd:date .
